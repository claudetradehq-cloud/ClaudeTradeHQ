# Copy to .env.local and fill in. .env.local is gitignored.

# Viewer PINs for the FX Blue statements on /fx-blue-links.
# lib/fxblue-parse.ts posts the matching PIN to api.fxblue.com/_NeedPin.aspx,
# then fetches the statement with the cookie. A missing PIN serves the cached
# snapshot instead of live numbers. Never commit the values.
# Set the same names in Vercel → Settings → Environment Variables.
#
# VuCuBit_Demo_ (ClaudeTradeHQ_081926 panel).
FXBLUE_PIN=
# VuCuBit_25K (ClaudeTradeHQ panel). Separate from FXBLUE_PIN.
FXBLUE_PIN_25K=
# vucubit_The5ers (ClaudeTradeHQ The5ers panel). Separate from FXBLUE_PIN.
FXBLUE_PIN_THE5ERS=
