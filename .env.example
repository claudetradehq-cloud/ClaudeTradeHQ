# Copy to .env.local and fill in. .env.local is gitignored.

# View PIN set on the FX Blue accounts (www.fxblue.com/users/<id>).
# lib/fxblue-parse.ts appends it as ?pin= when scraping api.fxblue.com, so
# without it /fx-blue-links serves cached numbers instead of live ones.
# Set the same value in Vercel → Settings → Environment Variables.
FXBLUE_PIN=
