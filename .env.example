# Copy to .env.local and fill in. .env.local is gitignored.

# ClaudeTradeHQ FX Blue viewer PIN. lib/fxblue-parse.ts posts it to
# api.fxblue.com/_NeedPin.aspx, then fetches the statement with the cookie.
# Without it /fx-blue-links serves cached numbers instead of live ones.
# This is not a VuCuBit account PIN. Those accounts are separate.
# Set the same value in Vercel → Settings → Environment Variables.
FXBLUE_PIN=
